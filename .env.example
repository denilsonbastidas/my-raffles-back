# Use the existing production URI, including the same database name.
MONGO_URI=mongodb://127.0.0.1:27017/raffles?replicaSet=rs0
ADMIN_SECRET=replace-with-your-existing-admin-secret
BREVO_API_KEY=replace-with-your-brevo-api-key
# Railway provides PORT automatically; this value is for local development.
PORT=5000
